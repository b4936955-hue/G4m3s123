# Copy to .env only for local development. Do not commit this file with values.
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=unblocked_zone
JWT_SECRET=replace-with-a-long-random-secret
# Required for opening the HTML directly as a file:// page (Origin: null).
# This API uses bearer tokens rather than cookies; CORS is not authorization.
ALLOWED_ORIGIN=*
OWNER_USERNAMES=yourusername
PORT=8787
